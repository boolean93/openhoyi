<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Only the isolated Mock may read/write the same-signature test APK's fixture provider. -->
    <uses-permission android:name="io.openhoyi.mobile.mock.test.permission.CURVE_FIXTURE" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-feature android:name="android.hardware.bluetooth_le" tools:node="remove" />
    <application>
        <provider android:name=".AiStorageProbeProvider" android:authorities="io.openhoyi.mobile.mock.ai_storage_probe"
            android:exported="false" android:grantUriPermissions="false" android:process=":ai_offline_preview" />
        <!-- Display-only candidate, not a product navigation destination or hardware acceptance. -->
        <activity android:name=".StrictVisualSampleActivity" android:exported="false" />
        <activity android:name=".AiChatPreviewActivity" android:exported="false" />
        <activity android:name=".AiOfflinePreviewActivity" android:exported="true"
            android:process=":ai_offline_preview" android:excludeFromRecents="true"
            android:taskAffinity="io.openhoyi.mobile.mock.ai_offline_preview" />
    </application>
</manifest>
